{
	"name": "@victor-software-house/exa-cli",
	"version": "0.0.0",
	"description": "Public CLI for Exa search, contents, and answer with a local SQLite cache.",
	"license": "MIT",
	"author": "Victor Araújo and Victor Software House <victor@victor-software-house.com>",
	"type": "module",
	"bin": {
		"exa": "./dist/cli.mjs"
	},
	"exports": {
		".": {
			"types": "./dist/cli.d.mts",
			"import": "./dist/cli.mjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"skills",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"scripts": {
		"prepublishOnly": "mise run verify"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "bun@1.4.0",
	"devEngines": {
		"runtime": {
			"name": "bun",
			"version": ">=1.4.0 <2.0.0"
		},
		"packageManager": {
			"name": "bun",
			"version": ">=1.4.0 <2.0.0"
		}
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/victor-software-house/exa-cli.git"
	},
	"homepage": "https://github.com/victor-software-house/exa-cli#readme",
	"bugs": {
		"url": "https://github.com/victor-software-house/exa-cli/issues"
	},
	"keywords": [
		"exa",
		"cli",
		"search",
		"optique"
	],
	"dependencies": {
		"@hey-api/client-fetch": "0.13.1",
		"@optique/core": "1.2.4",
		"@optique/env": "1.2.4",
		"@optique/run": "1.2.4",
		"@optique/zod": "1.2.4",
		"picocolors": "1.1.1",
		"zod": "4.5.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"@changesets/cli": "2.31.1",
		"@changesets/get-github-info": "0.8.0",
		"@changesets/types": "6.1.0",
		"@commitlint/cli": "21.2.2",
		"@commitlint/config-conventional": "21.2.2",
		"@hey-api/openapi-ts": "0.99.0",
		"@limegrass/eslint-plugin-import-alias": "1.6.1",
		"@types/bun": "1.4.0",
		"eslint-plugin-zod": "4.10.0",
		"liquidjs": "10.27.2",
		"oxlint": "1.80.0",
		"oxlint-tsgolint": "7.0.2001",
		"tsdown": "0.22.14",
		"typescript": "5.9.3"
	}
}
