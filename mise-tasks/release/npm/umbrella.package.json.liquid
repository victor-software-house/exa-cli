{
	"name": "{{ manifest.name }}",
	"version": "{{ manifest.version }}",
	"description": "{{ manifest.description }}",
	"license": "{{ manifest.license }}",
	"author": {
		"name": "{{ manifest.author.name }}",
		"email": "{{ manifest.author.email }}"
	},
	"type": "module",
	"bin": { "exa": "./bin/exa.mjs" },
	"files": ["bin", "skills", "README.md", "CHANGELOG.md", "LICENSE"],
	"engines": { "node": ">=20" },
	"publishConfig": {
		"access": "{{ manifest.publishConfig.access }}",
		"registry": "{{ manifest.publishConfig.registry }}"
	},
	"repository": {
		"type": "{{ manifest.repository.type }}",
		"url": "{{ manifest.repository.url }}"
	},
	"homepage": "{{ manifest.homepage }}",
	"bugs": { "url": "{{ manifest.bugs.url }}" },
	"keywords": [
		{%- for keyword in manifest.keywords %}
		"{{ keyword }}"{% unless forloop.last %},{% endunless %}
		{%- endfor %}
	],
	"optionalDependencies": {
		{%- for target in platforms %}
		"{{ manifest.name }}-{{ target.platform }}": "{{ manifest.version }}"{% unless forloop.last %},{% endunless %}
		{%- endfor %}
	}
}
